# Copy to .env.local for local development. Never commit .env.local.

# Server-only: the Express API that /api/* is forwarded to. Never exposed to
# the browser (no NEXT_PUBLIC_ prefix). http is accepted only for loopback hosts.
BACKEND_ORIGIN=http://127.0.0.1:3000

# Shown in the header.
NEXT_PUBLIC_APP_NAME=Ecommerce

# Public origin for absolute canonical and Open Graph URLs (set per deployment).
# NEXT_PUBLIC_SITE_URL=https://shop.example.com

# Optional, server-only: forward the browser address to Express for rate
# limiting. Only for a header your host overwrites on every request (Vercel:
# x-real-ip). Express must have the same PROXY_CLIENT_IP_SECRET (32+ chars).
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# PROXY_CLIENT_IP_SECRET=
