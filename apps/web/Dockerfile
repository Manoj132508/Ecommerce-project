# syntax=docker/dockerfile:1.7
# Next.js storefront: production image (docs/DOCKER_SETUP.md).
# Build context: apps/web. Three stages — dependencies, build, runtime — and
# only the runtime stage ships: the standalone server Next.js traces, its static
# assets and public/, on a distroless base (no shell, no package manager) as an
# unprivileged user. No secret is read at build time: BACKEND_ORIGIN,
# TRUSTED_CLIENT_IP_HEADER and PROXY_CLIENT_IP_SECRET are read by the server at
# request time from the container's environment.

# Both pinned by digest; both Debian 13 with Node.js 24.22.3 (CI uses Node 24).
# The build image has npm and a shell; the runtime image has only node.
ARG BUILD_IMAGE=node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs24-debian13:nonroot@sha256:6abfcb367ebc291572c774c1592a986be2ab26a2486f73093401327495a5962a

FROM ${BUILD_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Exact lockfile versions; no package install scripts run (none is needed:
# Next.js's compiler and sharp come as prebuilt platform packages).
RUN npm ci --no-audit --no-fund --ignore-scripts

FROM ${BUILD_IMAGE} AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Public values only: inlined into the browser bundle at build time, so they
# are part of the image by design. Never pass a secret as a build argument.
ARG NEXT_PUBLIC_APP_NAME=Ecommerce
ARG NEXT_PUBLIC_SITE_URL=
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_STANDALONE=true \
    NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN npm run build && mkdir -p .next/standalone/.next/cache

FROM ${RUNTIME_IMAGE} AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
# Application files belong to root and are read-only for the server user; the
# only writable path is the image-optimiser cache (a tmpfs in docker/compose.yaml,
# an ephemeral volume on ECS).
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
COPY --from=build --chown=65532:65532 /app/.next/standalone/.next/cache ./.next/cache
# distroless "nonroot" (uid 65532); stated explicitly.
USER 65532:65532
EXPOSE 3000
# Liveness without the API: robots.txt is generated by Next.js itself.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/robots.txt').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
STOPSIGNAL SIGTERM
# The image's entrypoint is /nodejs/bin/node.
CMD ["server.js"]
