{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Express + TypeScript and MongoDB API for the React ecommerce project",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy:migrations": "node -e \"require('node:fs').cpSync('db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run copy:migrations",
    "typecheck": "tsc -p tsconfig.json",
    "postgres:env": "tsx scripts/createPostgresEnv.ts",
    "postgres:check": "tsx scripts/checkPostgresConnection.ts",
    "db:migrate": "tsx scripts/dbMigrate.ts up",
    "db:status": "tsx scripts/dbMigrate.ts status",
    "db:rollback": "tsx scripts/dbMigrate.ts rollback",
    "data:dry-run": "tsx scripts/dataMigrate.ts dry-run",
    "data:import": "tsx scripts/dataMigrate.ts import",
    "data:verify": "tsx scripts/dataMigrate.ts verify",
    "data:rollback": "tsx scripts/dataMigrate.ts rollback",
    "migrate:product-descriptions": "tsx scripts/populateProductDescriptions.ts",
    "migrate:product-categories": "tsx scripts/populateProductCategories.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
