MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce
PORT=3000
CLIENT_URL=http://localhost:5173
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# PostgreSQL is configured separately in .env.postgres so the current MongoDB
# connection remains unchanged during the migration. See .env.postgres.example.

# Operational settings (Phase 7A). All optional; the values shown are the defaults.
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# SHUTDOWN_TIMEOUT_MS=10000
# Maintenance: refuse writes to shop data with 503 during a data copy or reconciliation.
# WRITE_FREEZE=false
# Staging only (with NODE_ENV=production): see auth/config.ts for every condition.
# DEPLOYMENT_ENVIRONMENT=staging
# AUTH_COOKIE_SESSIONS_STAGING=true
