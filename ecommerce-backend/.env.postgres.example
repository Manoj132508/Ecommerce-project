# Copy this file to .env.postgres before starting PostgreSQL.
# Use a long, unique local password. Do not commit .env.postgres.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used by the Express pg connection in config/postgres.js.
# Keep the password here identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql://ecommerce_app:replace-with-a-long-random-password@127.0.0.1:5432/ecommerce

